generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model RXNCONSO {
  RXCUI    String  @db.VarChar(8)
  LAT      String  @default("ENG") @db.VarChar(3)
  TS       String? @db.VarChar(1)
  LUI      String? @db.VarChar(8)
  STT      String? @db.VarChar(3)
  SUI      String? @db.VarChar(8)
  ISPREF   String? @db.VarChar(1)
  RXAUI    String  @db.VarChar(8)
  SAUI     String? @db.VarChar(50)
  SCUI     String? @db.VarChar(50)
  SDUI     String? @db.VarChar(50)
  SAB      String  @db.VarChar(20)
  TTY      String  @db.VarChar(20)
  CODE     String  @db.VarChar(50)
  STR      String  @db.VarChar(3000)
  SRL      String? @db.VarChar(10)
  SUPPRESS String? @db.VarChar(1)
  CVF      String? @db.VarChar(50)
  id       Int     @id @default(autoincrement())
}

model RXNREL {
  RXCUI1   String? @db.VarChar(8)
  RXAUI1   String? @db.VarChar(8)
  STYPE1   String? @db.VarChar(50)
  REL      String? @db.VarChar(4)
  RXCUI2   String? @db.VarChar(8)
  RXAUI2   String? @db.VarChar(8)
  STYPE2   String? @db.VarChar(50)
  RELA     String? @db.VarChar(100)
  RUI      String? @db.VarChar(10)
  SRUI     String? @db.VarChar(50)
  SAB      String  @db.VarChar(20)
  SL       String? @db.VarChar(1000)
  DIR      String? @db.VarChar(1)
  RG       String? @db.VarChar(10)
  SUPPRESS String? @db.VarChar(1)
  CVF      String? @db.VarChar(50)
  id       Int     @id @default(autoincrement())
}

model RXNSAT {
  RXCUI    String? @db.VarChar(8)
  LUI      String? @db.VarChar(8)
  SUI      String? @db.VarChar(8)
  RXAUI    String? @db.VarChar(8)
  STYPE    String? @db.VarChar(50)
  CODE     String? @db.VarChar(50)
  ATUI     String? @db.VarChar(11)
  SATUI    String? @db.VarChar(50)
  ATN      String  @db.VarChar(1000)
  SAB      String  @db.VarChar(20)
  ATV      String? @db.VarChar(4000)
  SUPPRESS String? @db.VarChar(1)
  CVF      String? @db.VarChar(50)
  id       Int     @id @default(autoincrement())
}
